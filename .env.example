# URL pública definitiva (cuando tengas dominio). En Vercel, si no se define,
# se usa automáticamente la URL de producción del proyecto (*.vercel.app).
NEXT_PUBLIC_SITE_URL=

# Formulario de contacto (https://resend.com → API Keys).
RESEND_API_KEY=

# Opcionales. Por defecto: 3dviewportstudio@gmail.com y el remitente de pruebas de Resend.
# Para enviar desde tu propio dominio, verifícalo en Resend y usa p. ej. "ViewportStudio3D <web@tudominio.com>".
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Aviso legal (LSSI-CE). Titular y NIF ya están en src/lib/site.ts; aquí solo si quieres sobrescribirlos.
NEXT_PUBLIC_LEGAL_ADDRESS=
